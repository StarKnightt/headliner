# Copy to .env.local (gitignored). Never commit real values. Server-side only: none of these
# are NEXT_PUBLIC_, so they never reach the browser.

# Qloo hackathon key. Leave empty to run on MOCK fixtures (the UI labels every mock result).
QLOO_API_KEY=
# Optional override; defaults to https://hackathon.api.qloo.com
QLOO_BASE_URL=

# LLM (any OpenAI-compatible Chat Completions API with tool calling).
# Precedence: LLM_PROVIDER if set (groq | openai | custom | none), else GROQ_API_KEY, else OPENAI_API_KEY.
# With no LLM configured, Headliner uses its deterministic planner (still Qloo-grounded).
LLM_PROVIDER=
GROQ_API_KEY=
OPENAI_API_KEY=
# Used with LLM_PROVIDER=custom, or to override the provider defaults.
LLM_API_KEY=
LLM_BASE_URL=
# Defaults: groq -> openai/gpt-oss-120b, openai -> gpt-4.1-mini
LLM_MODEL=
